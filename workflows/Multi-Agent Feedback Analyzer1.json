      "parameters": {
        "jsCode": "const cleaned = $json.output\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst result = JSON.parse(cleaned);\n\nreturn [\n  {\n    json: {\n      sentiment: result.sentiment\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
