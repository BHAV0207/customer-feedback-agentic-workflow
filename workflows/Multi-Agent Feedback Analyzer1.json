      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const cleaned = item.json.output\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  const data = JSON.parse(cleaned);\n\n  return {\n    json: {\n      insight: data.insight,\n      priority: data.priority\n    }\n  };\n});"
      },
